# Projet Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# Adresse publique de l'appli (sert au lien de connexion envoyé par email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresses autorisées à se connecter, séparées par des virgules (variable serveur, jamais envoyée au navigateur)
ALLOWED_EMAILS=toi@example.com
